# Modal (GPU host) - leave empty for local dev
MODAL_TOKEN=

# Comma-separated list of allowed CORS origins
# Update to your deployed frontend URL before running modal deploy
CORS_ORIGINS=http://localhost:5173

# Which inference runner to use: local | modal
INFERENCE_RUNNER=local

# Upload directory override
# On Modal this is set automatically to /canopylens-data/uploads (the Volume).
# On HF Spaces it defaults to /tmp/canopylens-uploads.
# Leave empty for local dev (defaults to backend/uploads/).
CANOPYLENS_UPLOAD_ROOT=

# Google Gemini Vision API Key (optional stealth tree counting verification)
GEMINI_API_KEY=